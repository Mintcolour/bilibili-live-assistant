<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BilibiliLiveAssistant.Core\BilibiliLiveAssistant.Core.csproj" />
    <ProjectReference Include="..\BilibiliLiveAssistant.Infrastructure\BilibiliLiveAssistant.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BilibiliLiveAssistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>true</WindowsAppSDKBootstrapInitialize>
    <IncludeProjectPriFile>true</IncludeProjectPriFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
  </ItemGroup>

  <Target Name="CopyPriFilesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PriFiles Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(PriFiles)" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
