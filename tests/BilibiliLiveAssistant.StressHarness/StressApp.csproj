<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BilibiliLiveAssistant.App</RootNamespace>
    <ApplicationManifest>../../src/BilibiliLiveAssistant.App/app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IncludeProjectPriFile>true</IncludeProjectPriFile>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../../src/BilibiliLiveAssistant.App</SourceRoot>
    <DefineConstants Condition="'$(TraySmoke)' == 'true'">$(DefineConstants);TRAY_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BilibiliLiveAssistant.Core/BilibiliLiveAssistant.Core.csproj" />
    <ProjectReference Include="../../src/BilibiliLiveAssistant.Infrastructure/BilibiliLiveAssistant.Infrastructure.csproj" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Include="MemorySoakApp.cs" />
    <Compile Include="$(SourceRoot)/*.cs" Exclude="$(SourceRoot)/App.xaml.cs" />
    <Content Include="../../assets/icons/app.ico" Link="Assets/app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <XamlResourceFiles Include="$(TargetDir)*.pri;$(TargetDir)**\*.xbf" Exclude="$(TargetDir)publish\**\*;$(PublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlResourceFiles)" DestinationFiles="@(XamlResourceFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
