{
  "manifest_version": 3,
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "name": "B站直播助手 · 本机登录同步",
  "version": "1.0.0",
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "incognito": "not_allowed"
}
