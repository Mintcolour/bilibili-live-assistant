{
  "manifest_version": 3,
  "host_permissions": [
    "*://bilibili.com/*",
    "*://api.bilibili.com/*",
    "*://api.live.bilibili.com/*"
  ],
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/app-32.png", "64": "icons/app-64.png" }
  },
  "icons": { "32": "icons/app-32.png", "64": "icons/app-64.png" },
  "description": "将当前普通浏览器配置的 B站登录状态同步到本机直播助手，无云端上传。",
  "name": "B站直播助手 · 本机登录同步",
  "version": "1.0.0",
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "incognito": "not_allowed"
}
